# Application Settings
PROJECT_NAME="AI Smart Logistics Tracking System"
ENVIRONMENT=development

# MySQL Database Configuration
# Luu y: Neu chay ngoai Docker tren may host ket noi qua docker-compose, dung port 3307.
# Neu ket noi toi MySQL cuc bo tren may host (XAMPP/MySQL Server), dung port 3306.
MYSQL_SERVER=localhost
MYSQL_PORT=3307
MYSQL_USER=logistics_user
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DB=ai_logistics_db

# Security & JWT Token
# Luu y: Phai doi SECRET_KEY thanh chuoi ngau nhien an toan (toi thieu 32 ky tu) truoc khi deploy
SECRET_KEY=change_this_to_a_secure_random_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Account (Seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me
INITIAL_ADMIN_FULLNAME="System Administrator"

# CORS Configuration (Format: JSON Array string hoac chuoi ngan cach boi dau phay)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

