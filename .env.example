# =============================================================================
# HỆ THỐNG AI TRUY VẾT & ĐIỀU PHỐI KHO THÔNG MINH (SV2026-ICTU-08)
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG DÙNG CHUNG (.env.example)
#
# Hướng dẫn sử dụng:
# 1. Tạo bản sao của file này thành '.env' trên máy của bạn: cp .env.example .env
# 2. Điền các giá trị bí mật thực tế vào file '.env'
# 3. Tuyệt đối KHÔNG commit file '.env' chứa thông tin thật lên Git!
# =============================================================================

# Cấu hình dự án
PROJECT_NAME="Hệ Thống AI Truy Vết & Điều Phối Kho Thông Minh"
PROJECT_CODE="SV2026-ICTU-08"
VERSION="1.0.0"
ENVIRONMENT="development"

# Bảo mật & Mã hóa JWT (Access Token)
# Thay đổi SECRET_KEY bằng một chuỗi ngẫu nhiên tối thiểu 32 ký tự
SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Mật khẩu khởi tạo tài khoản ban đầu (chỉ dùng cho lần seed CSDL đầu tiên)
INITIAL_ADMIN_PASSWORD="Admin@ICTU2026!Secure"
INITIAL_OPERATOR_PASSWORD="Operator@ICTU2026!Secure"
INITIAL_VIEWER_PASSWORD="Viewer@ICTU2026!Secure"

# Kết nối Cơ sở dữ liệu (SQLite cho môi trường local/test, MySQL cho máy chủ thật)
DATABASE_URL="sqlite:///./logistics.db"
# DATABASE_URL="mysql+pymysql://ai_logistics:SecurePassword2026@localhost:3306/ai_logistics_db"

# Kênh truyền trực quan hóa WebSocket & Mô phỏng
WS_FPS_TARGET=60
CONVEYOR_SPEED_PIXELS_PER_SEC=135.0

